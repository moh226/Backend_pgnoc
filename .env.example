# Django
# Clef secrète : générer une valeur aléatoire, par exemple avec :
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=""
DJANGO_SIGNING_KEY=""
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# utilisé uniquement quand DJANGO_DEBUG=False
# Origines de confiance CSRF (schéma + hôte), séparées par des virgules.
#DJANGO_CSRF_TRUSTED_ORIGINS=https://app.example.com
# Redirection HTTP→HTTPS (True par défaut en prod).
#DJANGO_SECURE_SSL_REDIRECT=True
# Durée HSTS en secondes (0 pour désactiver le temps de valider le HTTPS).
#DJANGO_SECURE_HSTS_SECONDS=31536000

# PostgreSQL
POSTGRES_DB=pgnoc_ti
POSTGRES_USER=pgnoc_user
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Redis / Celery
REDIS_URL=redis://localhost:6379/1
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@pgnoc-ti.local
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# MinIO (S3-compatible)
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=pgnoc-ti-documents
# Laisser VIDE pour tester en mode local (fichiers dans media/, servis
# par Django) — aucune dépendance. Renseigner l'URL pour utiliser MinIO
# (docker compose up minio) : URLs signées et stockage S3 réels.
MINIO_ENDPOINT_URL=
MINIO_USE_SSL=False

# DRF
DRF_PAGE_SIZE=20
DRF_THROTTLE_LOGIN=5/min
DRF_THROTTLE_REGISTER=3/min
DRF_THROTTLE_OTP=10/min

# OAuth Google — créer des identifiants sur Google Cloud Console
# (https://console.cloud.google.com/apis/credentials)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_CALLBACK_URL=http://localhost:8000/api/comptes/oauth/google/callback/
GOOGLE_OAUTH_FRONT_REDIRECT=http://localhost:5173/oauth

# Journalisation applicative
# Niveaux : DEBUG / INFO / WARNING / ERROR / CRITICAL.
#DJANGO_LOG_LEVEL=INFO
# Écrire les journaux dans des fichiers rotatifs (logs/application.log,
# logs/audit.log) en plus de la console ? Désactiver (False) dans les
# conteneurs qui collectent uniquement stdout.
#DJANGO_LOG_TO_FILE=True
#DJANGO_LOG_DIR=logs
